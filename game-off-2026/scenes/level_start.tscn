shader_parameter/alpha = 1.0

[sub_resource type="GDScript" id="GDScript_1ag0p"]
script/source = "extends Node2D

const FADE_TIME = 1.0
const CONTINUE_TEXT_FADE_START = 3.5
const CONTINUE_TEXT_FADE_END = 4

var time := 0.0
var fadeout_target := -1.0

func _ready() -> void:
	modulate.a = 0

func _process(delta: float) -> void:
	modulate.a = 1
	time += delta
	
	var alpha : float
	if time < FADE_TIME:
		alpha = time / FADE_TIME
	elif fadeout_target > 0:
		if time > fadeout_target:
			VisualTools.start_in_transition()
			get_tree().change_scene_to_file(LevelManager.get_room())
		alpha = (fadeout_target - time) / FADE_TIME
	else:
		alpha = 1
		
	material.set_shader_parameter(\"alpha\", alpha)
	
	if time < CONTINUE_TEXT_FADE_START:
		%ToContinue.modulate.a = 0
	elif time < CONTINUE_TEXT_FADE_END:
		%ToContinue.modulate.a = (time - CONTINUE_TEXT_FADE_START) / (CONTINUE_TEXT_FADE_END - CONTINUE_TEXT_FADE_START)
	else:
		%ToContinue.modulate.a = 1
	
	%LevelLabel.text = \"Level \" + str(LevelManager.room_number + 1)
	%Tip.text = LevelManager.room_to_tip[LevelManager.rooms[LevelManager.room_number]]
	
	if Input.is_action_just_pressed(\"toggle_play\") and time > FADE_TIME and fadeout_target < 0:
		fadeout_target = time + FADE_TIME
"

