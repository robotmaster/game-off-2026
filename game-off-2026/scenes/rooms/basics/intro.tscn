[sub_resource type="GDScript" id="GDScript_83bra"]
script/source = "extends TriggerHint

var moved := false


func override_hint_spawn_pos() -> Vector2:
	return get_node(\"../Player\").global_position

func override_hint_time_increment(delta: float) -> void:
	if Input.is_action_just_pressed(\"left\") or Input.is_action_just_pressed(\"right\") or Input.is_action_just_pressed(\"up\"):
		moved = true
	
	if not moved:
		spawn_hint_timer += delta
	else:
		spawn_hint_timer = spawn_hint_initial_value
"

[sub_resource type="GDScript" id="GDScript_n74t1"]
script/source = "extends TriggerHint

var moved := false
var jumped := false

func override_hint_spawn_pos() -> Vector2:
	return get_node(\"../Player\").global_position

func override_hint_time_increment(delta: float) -> void:
	if Input.is_action_just_pressed(\"left\") or Input.is_action_just_pressed(\"right\") or Input.is_action_just_pressed(\"up\"):
		moved = true
	
	if Input.is_action_just_pressed(\"up\"):
		jumped = true
	
	if moved and not jumped:
		spawn_hint_timer += delta
	else:
		spawn_hint_timer = spawn_hint_initial_value
"

