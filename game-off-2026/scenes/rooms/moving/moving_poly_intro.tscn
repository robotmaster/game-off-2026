[sub_resource type="GDScript" id="GDScript_2kkdi"]
script/source = "extends TriggerHint

var x_pressed := false
var moved := false

var original_positions := [Vector2(-9999, 0), Vector2(-9999, 0), Vector2(-9999, 0)]

func inherit_ready() -> void:
	spawn_hint_timer = -5.0
	spawn_hint_initial_value = -5.0

func override_hint_time_increment(delta: float) -> void:
	if original_positions[0].x == -9999:
		original_positions[0] = get_node(\"..\").color_1_parent.global_position
		original_positions[1] = get_node(\"..\").color_2_parent.global_position
		original_positions[2] = get_node(\"..\").color_3_parent.global_position
	
	if original_positions[0] != get_node(\"..\").color_1_parent.global_position:
		moved = true
	if original_positions[1] != get_node(\"..\").color_2_parent.global_position:
		moved = true
	if original_positions[2] != get_node(\"..\").color_3_parent.global_position:
		moved = true
	
	if get_node(\"..\").transform_editing_index > 0:
		x_pressed = true
	
	if get_node(\"..\").is_editing and moved and x_pressed:
		spawn_hint_timer += delta
	else:
		spawn_hint_timer = spawn_hint_initial_value
"

